{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "visionMCP configuration",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["ollama", "openai", "anthropic"],
      "default": "ollama",
      "description": "Which vision backend to use."
    },
    "api_key": {
      "type": "string",
      "default": "",
      "description": "API key. Leave empty to fall back to OPENAI_API_KEY / ANTHROPIC_API_KEY. Ignored for ollama."
    },
    "api_url": {
      "type": "string",
      "default": "",
      "description": "API base URL. Empty = provider default (e.g. http://localhost:11434/v1 for ollama)."
    },
    "model": {
      "type": "string",
      "default": "",
      "description": "Vision model. Empty = provider default."
    },
    "max_image_mb": {
      "type": "number",
      "minimum": 0.1,
      "default": 5,
      "description": "Payload ceiling in MB; larger images are shrunk to JPEG."
    },
    "timeout": {
      "type": "number",
      "minimum": 1,
      "default": 120,
      "description": "Timeout in seconds for model calls and image downloads."
    },
    "transport": {
      "type": "string",
      "enum": ["stdio", "http", "sse", "streamable-http"],
      "default": "stdio",
      "description": "MCP transport. stdio for local clients; http/sse for hosting."
    },
    "host": {
      "type": "string",
      "default": "0.0.0.0",
      "description": "Bind address for http/sse transports."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8100,
      "description": "Port for http/sse transports."
    }
  },
  "additionalProperties": false
}